# .env.example — variables de entorno del PFC (equipo ACC — Soporte Técnico ISP).
#
# El "docker compose up -d" de la raiz NO necesita ningun .env: todos los valores de
# docker-compose.yml ya traen un default funcional (ver el archivo, no hay ninguna
# sustitucion "${VAR}" pendiente de completar). Este archivo documenta que se puede
# sobreescribir si se corre algun servicio SUELTO, fuera de Docker (por ejemplo,
# depurando un microservicio desde el IDE apuntando al resto del stack ya levantado).
#
# Uso real: copiar la seccion del servicio que vayas a correr, o setear las variables
# antes de `mvn spring-boot:run` / `npm run dev` / `uvicorn` / `./gradlew installDebug`.

# ---------- Cluster CockroachDB (compartido por auth-service, ticket-service, report-service) ----------
DB_USER=root
DB_PASS=

# ---------- api-gateway (puerto 8000, unico punto de entrada) ----------
SERVER_PORT=8000
AUTH_SERVICE_URI=http://localhost:8001
TICKET_SERVICE_URI=http://localhost:8002
REPORT_SERVICE_URI=http://localhost:8005

# ---------- auth-service (puerto 8001) ----------
DB_URL=jdbc:postgresql://localhost:26257/auth_db?sslmode=disable
AUTH_JWT_SECRET=cambia-este-secreto-en-produccion
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=7
ADMIN_BOOTSTRAP_EMAIL=admin@soporte.local
ADMIN_BOOTSTRAP_PASSWORD=Admin123!

# ---------- ticket-service / svc-principal (puerto 8002) ----------
# DB_URL para este servicio: jdbc:postgresql://localhost:26257/ticket_db?sslmode=disable
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUTH_SERVICE_URL=http://localhost:8001/api/v1/auth
# Adicion 1 (Ampliacion del Modulo G) -- ver docs/adr/0008-correl-incidencias.md.
# CORREL: c0 (sin correlacion, default) | c1 (zona+ventana) | c2 (zona+ventana+telemetria).
CORREL=c0
CORREL_WINDOW_MINUTES=15
TELEMETRY_SERVICE_HOST=localhost
TELEMETRY_SERVICE_GRPC_PORT=9095

# ---------- ai-service (puerto 8004, prefijo AI_SERVICE_) ----------
AI_SERVICE_PORT=8004
AI_SERVICE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_SERVICE_MONGO_URI=mongodb://localhost:27017
AI_SERVICE_MONGO_DB=ai_db

# ---------- notification-service (puerto 8003, prefijo NOTIFICATION_SERVICE_) ----------
NOTIFICATION_SERVICE_PORT=8003
NOTIFICATION_SERVICE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_SERVICE_MONGO_URI=mongodb://localhost:27017
NOTIFICATION_SERVICE_MONGO_DB=notifications_db

# ---------- report-service (puerto 8005) ----------
# DB_URL para este servicio: jdbc:postgresql://localhost:26257/report_db?sslmode=disable
# KAFKA_BOOTSTRAP_SERVERS y AUTH_SERVICE_URL: mismos valores que ticket-service.

# ---------- telemetry-service (PE-U1, puerto 8006) ----------
# Canal de telemetria de equipos del abonado y latidos de nodo -- ver
# docs/adr/0007-pe-u1-telemetria.md. Sin base de datos ni Kafka: el buffer vive en memoria
# del propio servicio.
TELEMETRY_SOCKET_PORT=9500
TELEMETRY_GRPC_PORT=9095

# ---------- apps/web (Vite, puerto 5173 en Docker / 5173 en dev con "npm run dev") ----------
# Sin ninguna de estas variables, apps/web asume que el API Gateway esta en
# http://localhost:8000/ (ver apps/web/src/lib/apiClient.ts) -- solo hace falta
# declararlas para apuntar a otro entorno (staging, otro puerto, etc).
VITE_GATEWAY_BASE_URL=http://localhost:8000/
# VITE_AUTH_BASE_URL / VITE_TICKETS_BASE_URL / VITE_REPORTS_BASE_URL: overrides
# individuales, solo para depuracion local llamando a un servicio suelto sin gateway.

# ---------- apps/mobile (Gradle build config, NO variables de entorno) ----------
# El emulador de Android usa 10.0.2.2 como alias de "localhost" de la maquina host --
# ya viene asi por default en apps/mobile/app/build.gradle.kts (AUTH_BASE_URL /
# TICKETS_BASE_URL). Para un dispositivo fisico real, reemplazar 10.0.2.2 por la IP de
# LAN de la maquina que corre el stack.

# ---------- Observabilidad (Modulo F) ----------
# otel-collector, Tempo, Prometheus, Grafana y cAdvisor no requieren ninguna variable
# para levantarse (ver ops/*/*.yaml). Puertos por defecto una vez levantado el stack:
#   Grafana:     http://localhost:3000  (acceso anonimo de solo lectura)
#   Prometheus:  http://localhost:9090
#   Tempo (API): http://localhost:3200
# Los servicios Java reciben OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# automaticamente desde docker-compose.yml (agente Java de OpenTelemetry, ver Dockerfile
# de cada servicio) -- no hace falta declararlo aqui salvo que se corra un servicio
# suelto fuera de Docker y se quiera que tambien reporte trazas.
