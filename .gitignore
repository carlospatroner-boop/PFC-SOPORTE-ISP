*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.log

# Datos generados (grandes, no van al repo)
spark/data/processed/
spark/results/*.png
spark/results/*.csv

# Playwright (apps/web/e2e) -- reporte HTML y trazas de cada corrida, se regeneran solos
apps/web/playwright-report/
apps/web/test-results/

