    family-names: Álvarez Párraga
repository-code: 'https://github.com/carlospatroner-boop/PFC-SOPORTE-ISP'
license: MIT
date-released: '2026-09-04'
keywords:
  - sistemas distribuidos
  - microservicios
  - CockroachDB
  - Apache Kafka
  - Apache Spark
  - observabilidad
  - ISO/IEC 25010
